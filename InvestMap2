<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="theme-color" content="#0a0e1a">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>InvestMap</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root{--bg:#080c18;--surface:#0f1528;--surface2:#161d35;--border:rgba(255,255,255,0.07);--accent:#00d4aa;--text:#e8edf5;--muted:#6b7a99;--danger:#f25f5c;--green:#2dd4a0;--red:#f25f5c}
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:'Syne',sans-serif}
  #lockScreen{position:fixed;inset:0;z-index:1000;background:radial-gradient(ellipse at 30% 20%,#1a1040 0%,#080c18 60%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:32px;transition:opacity .4s,transform .4s}
  #lockScreen.hidden{opacity:0;transform:scale(1.04);pointer-events:none}
  .lock-logo{text-align:center}.app-name{font-size:2rem;font-weight:800;letter-spacing:-1px}.app-name span{color:var(--accent)}
  .sub{font-family:'DM Mono',monospace;font-size:.7rem;color:var(--muted);letter-spacing:3px;margin-top:4px}.lock-icon{font-size:2.5rem;margin-bottom:8px}
  .pin-display{display:flex;gap:14px}
  .pin-dot{width:14px;height:14px;border-radius:50%;border:2px solid var(--accent);background:transparent;transition:background .15s,transform .15s}
  .pin-dot.filled{background:var(--accent);transform:scale(1.2)}
  .pin-hint{font-family:'DM Mono',monospace;font-size:.72rem;color:var(--muted);text-align:center}
  .pin-error{color:var(--danger);font-size:.75rem;font-family:'DM Mono',monospace;text-align:center;min-height:18px;animation:shake .3s}
  @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
  .numpad{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;width:260px}
  .num-btn{height:68px;border-radius:16px;background:var(--surface);border:1px solid var(--border);color:var(--text);font-family:'Syne',sans-serif;font-size:1.4rem;font-weight:600;cursor:pointer;transition:background .12s,transform .08s;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px}
  .num-btn:active{background:var(--surface2);transform:scale(.94)}
  .num-btn .num-sub{font-size:.45rem;font-family:'DM Mono',monospace;letter-spacing:1.5px;color:var(--muted)}
  .num-btn.del{font-size:1.1rem;background:transparent;border-color:transparent}
  .num-btn.empty{background:transparent;border-color:transparent;pointer-events:none}
  .first-time-setup{text-align:center;max-width:280px}
  .first-time-setup h3{font-size:1.1rem;margin-bottom:8px}
  .first-time-setup p{font-size:.8rem;color:var(--muted);line-height:1.6;font-family:'DM Mono',monospace}
  #app{height:100vh;display:flex;flex-direction:column;overflow:hidden}
  .topbar{padding:16px 20px 12px;display:flex;align-items:center;justify-content:space-between;background:var(--bg);border-bottom:1px solid var(--border);flex-shrink:0}
  .app-badge{font-size:1.1rem;font-weight:800;letter-spacing:-.5px}.app-badge span{color:var(--accent)}
  .topbar-icons{display:flex;gap:16px}
  .icon-btn{background:none;border:none;color:var(--muted);font-size:1.1rem;cursor:pointer;padding:4px;transition:color .15s}
  .icon-btn:active{color:var(--accent)}
  .icon-btn.spinning{animation:spin 1s linear infinite;color:var(--accent)}
  @keyframes spin{to{transform:rotate(360deg)}}
  .scroll-content{flex:1;overflow-y:auto;overflow-x:hidden;padding-bottom:80px}
  .scroll-content::-webkit-scrollbar{display:none}
  .summary-card{margin:16px;border-radius:20px;background:linear-gradient(135deg,#0f1f3d 0%,#0a1628 100%);border:1px solid rgba(0,212,170,.2);padding:24px;position:relative;overflow:hidden}
  .summary-card::before{content:'';position:absolute;top:-40px;right:-40px;width:160px;height:160px;border-radius:50%;background:radial-gradient(circle,rgba(0,212,170,.12) 0%,transparent 70%)}
  .summary-label{font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:3px;color:var(--muted);margin-bottom:6px}
  .summary-total{font-size:2.2rem;font-weight:800;letter-spacing:-1px;line-height:1}
  .summary-total .cents{font-size:1.2rem;font-weight:600;color:var(--muted)}
  .summary-row{display:flex;gap:16px;margin-top:20px;flex-wrap:wrap}.summary-stat{flex:1;min-width:60px}
  .s-label{font-family:'DM Mono',monospace;font-size:.58rem;letter-spacing:2px;color:var(--muted)}
  .s-val{font-size:.95rem;font-weight:700;margin-top:2px}
  .pos{color:var(--green)}.neg{color:var(--red)}
  .section-title{font-size:.7rem;font-family:'DM Mono',monospace;letter-spacing:3px;color:var(--muted);padding:16px 20px 8px;text-transform:uppercase}
  .alloc-bar{display:flex;height:8px;border-radius:8px;overflow:hidden;margin:0 20px 6px;gap:2px}
  .alloc-seg{height:100%;border-radius:8px}
  .alloc-legend{display:flex;flex-wrap:wrap;gap:8px 16px;padding:0 20px 4px}
  .alloc-item{display:flex;align-items:center;gap:6px;font-size:.72rem;font-family:'DM Mono',monospace;color:var(--muted)}
  .alloc-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
  /* QUOTE STATUS BANNER */
  .quote-banner{margin:0 16px 4px;padding:10px 14px;border-radius:12px;font-size:.68rem;font-family:'DM Mono',monospace;display:flex;align-items:center;gap:8px;border:1px solid var(--border)}
  .quote-banner.loading{background:rgba(0,212,170,.07);border-color:rgba(0,212,170,.2);color:var(--accent)}
  .quote-banner.success{background:rgba(45,212,160,.07);border-color:rgba(45,212,160,.2);color:var(--green)}
  .quote-banner.error{background:rgba(242,95,92,.07);border-color:rgba(242,95,92,.2);color:var(--red)}
  .quote-banner.warn{background:rgba(240,180,41,.07);border-color:rgba(240,180,41,.2);color:#f0b429}
  /* CHARTS */
  .chart-tabs{display:flex;margin:0 16px 10px;gap:6px}
  .chart-tab{flex:1;padding:8px 4px;border-radius:10px;border:1px solid var(--border);background:var(--surface);color:var(--muted);font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:1px;cursor:pointer;text-align:center;transition:all .2s}
  .chart-tab.active{background:var(--accent);color:#080c18;border-color:var(--accent);font-weight:700}
  .cat-scroller{display:flex;gap:6px;overflow-x:auto;padding:0 16px 10px;scrollbar-width:none}
  .cat-scroller::-webkit-scrollbar{display:none}
  .cat-pill{padding:5px 12px;border-radius:20px;border:1px solid var(--border);background:var(--surface);color:var(--muted);font-family:'DM Mono',monospace;font-size:.62rem;white-space:nowrap;cursor:pointer;flex-shrink:0;transition:all .2s}
  .cat-pill.active{font-weight:700;color:#080c18;border-color:transparent}
  .chart-card{margin:0 16px 12px;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:16px 12px 10px}
  .chart-header{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
  .chart-ttl{font-size:.8rem;font-weight:700}
  .chart-sub{font-size:.6rem;font-family:'DM Mono',monospace;color:var(--muted)}
  .chart-empty{text-align:center;padding:24px;color:var(--muted);font-family:'DM Mono',monospace;font-size:.72rem;line-height:1.8}
  /* CARDS */
  .cards-grid{display:flex;flex-direction:column;gap:10px;padding:4px 16px}
  .cat-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;transition:border-color .2s}
  .cat-card.expanded{border-color:rgba(255,255,255,.12)}
  .cat-header{display:flex;align-items:center;justify-content:space-between;padding:16px;cursor:pointer}
  .cat-left{display:flex;align-items:center;gap:12px}
  .cat-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0}
  .cat-name{font-size:.9rem;font-weight:700}.cat-count{font-size:.65rem;font-family:'DM Mono',monospace;color:var(--muted);margin-top:1px}
  .cat-right{text-align:right}.cat-value{font-size:1rem;font-weight:700;font-family:'DM Mono',monospace}
  .cat-change{font-size:.7rem;font-family:'DM Mono',monospace;margin-top:2px}
  .cat-arrow{color:var(--muted);font-size:.7rem;margin-left:8px;transition:transform .25s}
  .cat-card.expanded .cat-arrow{transform:rotate(180deg)}
  .inv-list{border-top:1px solid var(--border)}
  .inv-item{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--border);cursor:pointer}
  .inv-item:last-child{border-bottom:none}
  .inv-ticker{font-size:.85rem;font-weight:700}
  .inv-name{font-size:.65rem;color:var(--muted);font-family:'DM Mono',monospace;margin-top:1px;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .inv-right{text-align:right}.inv-value{font-size:.85rem;font-weight:600;font-family:'DM Mono',monospace}
  .inv-qty{font-size:.65rem;color:var(--muted);font-family:'DM Mono',monospace}
  .inv-badge{font-size:.6rem;font-family:'DM Mono',monospace;padding:2px 6px;border-radius:6px;margin-top:2px;display:inline-block}
  .badge-pos{background:rgba(45,212,160,.15);color:var(--green)}.badge-neg{background:rgba(242,95,92,.15);color:var(--red)}
  .live-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--green);margin-right:4px;animation:blink 2s infinite}
  @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
  .add-inv-btn{display:flex;align-items:center;gap:8px;padding:12px 16px;border-top:1px solid var(--border);background:none;border:none;color:var(--accent);font-family:'Syne',sans-serif;font-size:.82rem;font-weight:600;cursor:pointer;width:100%}
  .bottom-nav{position:fixed;bottom:0;left:0;right:0;background:var(--surface);border-top:1px solid var(--border);display:flex;padding:8px 0 max(8px,env(safe-area-inset-bottom));z-index:100}
  .nav-btn{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;background:none;border:none;color:var(--muted);cursor:pointer;font-size:.6rem;font-family:'DM Mono',monospace;letter-spacing:1px;padding:6px 0;transition:color .15s}
  .nav-btn .nav-icon{font-size:1.2rem}.nav-btn.active{color:var(--accent)}
  .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:200;display:flex;align-items:flex-end;opacity:0;pointer-events:none;transition:opacity .25s}
  .modal-overlay.open{opacity:1;pointer-events:all}
  .modal-sheet{width:100%;background:var(--surface);border-radius:24px 24px 0 0;padding:24px 20px max(24px,env(safe-area-inset-bottom));transform:translateY(100%);transition:transform .3s cubic-bezier(.34,1.56,.64,1);max-height:90vh;overflow-y:auto}
  .modal-sheet::-webkit-scrollbar{display:none}
  .modal-overlay.open .modal-sheet{transform:translateY(0)}
  .modal-handle{width:40px;height:4px;background:var(--border);border-radius:2px;margin:0 auto 20px}
  .modal-title{font-size:1.1rem;font-weight:800;margin-bottom:20px}
  .form-group{margin-bottom:16px}
  .form-label{font-size:.65rem;font-family:'DM Mono',monospace;letter-spacing:2px;color:var(--muted);margin-bottom:6px;display:block}
  .form-input,.form-select{width:100%;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:12px 14px;color:var(--text);font-family:'Syne',sans-serif;font-size:.9rem;outline:none;transition:border-color .2s}
  .form-input:focus,.form-select:focus{border-color:var(--accent)}
  .form-select option{background:var(--surface)}
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .form-hint{font-size:.65rem;font-family:'DM Mono',monospace;color:var(--muted);margin-top:4px}
  .btn-primary{width:100%;padding:14px;border-radius:14px;background:linear-gradient(135deg,var(--accent),#00b891);border:none;color:#080c18;font-family:'Syne',sans-serif;font-size:.95rem;font-weight:800;cursor:pointer;margin-top:8px;transition:opacity .15s,transform .1s}
  .btn-primary:active{opacity:.85;transform:scale(.98)}
  .btn-secondary{width:100%;padding:14px;border-radius:14px;background:var(--surface2);border:1px solid var(--border);color:var(--text);font-family:'Syne',sans-serif;font-size:.95rem;font-weight:700;cursor:pointer;margin-top:8px}
  .btn-danger{width:100%;padding:12px;border-radius:14px;background:transparent;border:1px solid var(--danger);color:var(--danger);font-family:'Syne',sans-serif;font-size:.85rem;font-weight:600;cursor:pointer;margin-top:8px}
  .detail-header{display:flex;align-items:center;gap:12px;margin-bottom:20px}
  .detail-icon{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.4rem}
  .detail-ticker{font-size:1.4rem;font-weight:800}
  .detail-name{font-size:.75rem;color:var(--muted);font-family:'DM Mono',monospace}
  .detail-price{font-size:2rem;font-weight:800;font-family:'DM Mono',monospace;margin:16px 0 4px}
  .detail-stats{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0}
  .detail-stat{background:var(--bg);border-radius:12px;padding:12px}
  .ds-label{font-size:.6rem;font-family:'DM Mono',monospace;letter-spacing:2px;color:var(--muted)}
  .ds-val{font-size:1rem;font-weight:700;margin-top:4px;font-family:'DM Mono',monospace}
  .settings-item{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:16px;margin-bottom:10px;cursor:pointer;display:flex;align-items:center;justify-content:space-between}
  .si-label{font-size:.9rem;font-weight:600}.si-sub{font-size:.68rem;color:var(--muted);font-family:'DM Mono',monospace;margin-top:2px}
  .history-item{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:14px 16px;margin-bottom:10px}
  .history-top{display:flex;justify-content:space-between;margin-bottom:4px}
  .history-ticker{font-weight:700;font-size:.9rem}.history-date{font-size:.65rem;color:var(--muted);font-family:'DM Mono',monospace}
  .history-desc{font-size:.75rem;color:var(--muted);font-family:'DM Mono',monospace}
  .toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--surface2);border:1px solid var(--border);padding:10px 20px;border-radius:12px;font-size:.8rem;font-family:'DM Mono',monospace;white-space:nowrap;opacity:0;transition:all .3s;z-index:500;pointer-events:none;max-width:90vw;text-align:center}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
</style>
</head>
<body>

<!-- LOCK -->
<div id="lockScreen">
  <div class="lock-logo"><div class="lock-icon">🔐</div><div class="app-name">Invest<span>Map</span></div><div class="sub">SEU PORTFÓLIO SEGURO</div></div>
  <div id="pinDisplay" class="pin-display"></div>
  <div id="pinHint" class="pin-hint">Digite seu PIN de 4 dígitos</div>
  <div id="pinError" class="pin-error"></div>
  <div class="numpad" id="numpad"></div>
  <div id="firstTimeMsg" class="first-time-setup" style="display:none"><h3>Crie seu PIN</h3><p>Escolha um PIN de 4 dígitos para proteger seus investimentos. Nenhum dado sai do seu dispositivo.</p></div>
</div>

<!-- APP -->
<div id="app" style="display:none">
  <div class="topbar">
    <div class="app-badge">Invest<span>Map</span></div>
    <div class="topbar-icons">
      <button class="icon-btn" id="refreshBtn" title="Buscar cotações">🔄</button>
      <button class="icon-btn" id="addBtn">＋</button>
    </div>
  </div>

  <!-- MAIN -->
  <div class="scroll-content" id="mainPage">
    <div class="summary-card">
      <div class="summary-label">PATRIMÔNIO TOTAL</div>
      <div class="summary-total" id="totalValue">R$ 0<span class="cents">,00</span></div>
      <div class="summary-row">
        <div class="summary-stat"><div class="s-label">LUCRO/PERDA</div><div class="s-val pos" id="profitVal">R$ 0,00</div></div>
        <div class="summary-stat"><div class="s-label">RENTAB.</div><div class="s-val pos" id="totalReturn">0,00%</div></div>
        <div class="summary-stat"><div class="s-label">ATIVOS</div><div class="s-val" id="assetCount">0</div></div>
      </div>
    </div>

    <div id="quoteBanner" style="display:none" class="quote-banner loading"></div>
    <div id="lastUpdateLabel" style="padding:0 20px 8px;font-size:.65rem;color:var(--muted);font-family:'DM Mono',monospace"></div>

    <div class="section-title">ALOCAÇÃO</div>
    <div class="alloc-bar" id="allocBar"></div>
    <div class="alloc-legend" id="allocLegend"></div>

    <div class="section-title" style="margin-top:8px">GRÁFICOS</div>
    <div class="chart-tabs">
      <button class="chart-tab active" data-chart="evolution">📈 Evolução</button>
      <button class="chart-tab" data-chart="monthly">📅 Mensal</button>
    </div>
    <div class="cat-scroller" id="catScroller"></div>
    <div class="chart-card">
      <div class="chart-header"><span class="chart-ttl" id="chartTitle">Carteira Total</span><span class="chart-sub" id="chartSub">Evolução do patrimônio</span></div>
      <canvas id="mainCanvas" height="150" style="width:100%"></canvas>
      <div id="chartEmpty" class="chart-empty" style="display:none">Adicione investimentos e atualize<br>cotações para ver o gráfico.</div>
    </div>

    <div class="section-title">CARTEIRA</div>
    <div class="cards-grid" id="cardsGrid"></div>
  </div>

  <!-- HISTORY -->
  <div class="scroll-content" id="historyPage" style="display:none">
    <div class="section-title">HISTÓRICO</div>
    <div id="historyList" style="padding:0 16px"></div>
  </div>

  <!-- SETTINGS -->
  <div class="scroll-content" id="settingsPage" style="display:none">
    <div class="section-title">CONFIGURAÇÕES</div>
    <div style="padding:0 16px">
      <div class="settings-item" id="changePinBtn"><div><div class="si-label">🔒 Alterar PIN</div><div class="si-sub">Mude sua senha de acesso</div></div><span style="color:var(--muted)">›</span></div>
      <div class="settings-item" id="exportBtn"><div><div class="si-label">📤 Exportar Dados</div><div class="si-sub">Baixar backup em JSON</div></div><span style="color:var(--muted)">›</span></div>
      <div class="settings-item" id="importBtn"><div><div class="si-label">📥 Importar Dados</div><div class="si-sub">Restaurar backup</div></div><span style="color:var(--muted)">›</span></div>
      <div class="settings-item" style="cursor:default"><div><div class="si-label">🛡️ Privacidade</div><div class="si-sub">Dados ficam apenas neste dispositivo. Apenas cotações públicas (B3/cripto) são consultadas online.</div></div></div>
      <div class="settings-item" id="brapiTokenBtn"><div><div class="si-label">🔑 Token Brapi (opcional)</div><div class="si-sub">Aumenta o limite de requisições de cotações</div></div><span style="color:var(--muted)">›</span></div>
      <div class="settings-item" style="cursor:default"><div><div class="si-label">📡 Fontes de dados</div><div class="si-sub">FIIs/Ações: Brapi (B3 oficial) · Cripto: CoinGecko · Atualiza sozinho a cada 5 min · Renda Fixa: manual</div></div></div>
      <input type="file" id="importFile" accept=".json" style="display:none">
    </div>
  </div>

  <nav class="bottom-nav">
    <button class="nav-btn active" data-page="main"><span class="nav-icon">📊</span><span>Carteira</span></button>
    <button class="nav-btn" data-page="history"><span class="nav-icon">📋</span><span>Histórico</span></button>
    <button class="nav-btn" data-page="settings"><span class="nav-icon">⚙️</span><span>Config</span></button>
  </nav>
</div>

<!-- ADD MODAL -->
<div class="modal-overlay" id="addModal">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="modal-title">Adicionar Investimento</div>
    <div class="form-group"><label class="form-label">TIPO</label>
      <select class="form-select" id="invType" onchange="onTypeChange()">
        <option value="FII">🏢 FII — Fundo Imobiliário</option>
        <option value="ACAO">📈 Ação</option>
        <option value="CDB">💳 CDB</option>
        <option value="LCI">🏠 LCI</option>
        <option value="LCA">🌾 LCA</option>
        <option value="TESOURO">🏛️ Tesouro Direto</option>
        <option value="CRYPTO">₿ Criptomoeda</option>
        <option value="OUTRO">📦 Outro</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">TICKER / NOME</label>
      <input type="text" class="form-input" id="invTicker" placeholder="Ex: BTHF11" maxlength="30" oninput="this.value=this.value.toUpperCase()">
      <div class="form-hint" id="tickerHint">Para FIIs e ações: use o código da B3 (ex: MXRF11, PETR4)</div>
    </div>
    <div class="form-group"><label class="form-label">DESCRIÇÃO (opcional)</label><input type="text" class="form-input" id="invName" placeholder="Ex: FII Maxi Renda, CDB 13% a.a." maxlength="60"></div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">VALOR APLICADO (R$)</label><input type="number" class="form-input" id="invApplied" placeholder="0,00" step="0.01" min="0"></div>
      <div class="form-group"><label class="form-label">QTD. COTAS/UNID.</label><input type="number" class="form-input" id="invQty" placeholder="0" step="0.000001" min="0"></div>
    </div>
